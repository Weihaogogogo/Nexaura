# 云服务器部署专用 .gitignore
# 使用白名单模式，只保留云服务器运行必需的文件

# 排除所有文件
*

# 保留后端核心文件
!app.py
!config.py
!exts.py
!requirements_production.txt

# 保留后端核心目录及其所有文件
!blueprints/
!blueprints/**
!utils/
!utils/**
!models/
!models/**

# 保留前端构建产物
!fronted/
!fronted/dist/
!fronted/dist/**

# 保留 Git 和文档文件
!.gitignore
!README.md

# 在保留的目录中排除这些不需要的文件
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.DS_Store
**/Thumbs.db
**/*.log
**/.env*
**/*.tmp
**/*.temp 